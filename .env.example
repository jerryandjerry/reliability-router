# Default mode is fully offline and deterministic.
RR_PROVIDER=mock

# Optional hosted-model provider.
# RR_PROVIDER=openai
# OPENAI_API_KEY=replace_me
RR_OPENAI_MODEL=gpt-5.5
RR_QUICK_MODEL=gpt-5.5
RR_DEEP_MODEL=gpt-5.5

# Policy controls.
RR_DEEP_THRESHOLD=0.48
RR_CRITICAL_THRESHOLD=0.78
RR_MAX_EVIDENCE_ITEMS=5
RR_MAX_REPAIR_ATTEMPTS=1
RR_FAIL_CLOSED=true
